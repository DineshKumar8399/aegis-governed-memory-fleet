# ─────────────────────────────────────────────────────────────────────────────
# Aegis: Governed Memory Fleet — environment configuration
# Copy to `.env.local` (Next.js) or `.env` (scripts) and fill in.
# ─────────────────────────────────────────────────────────────────────────────

# ── CockroachDB ──────────────────────────────────────────────────────────────
# CockroachDB Cloud (Basic/Standard/Advanced). Get this from the Cloud Console
# ("Connect" → "General connection string") or from:
#   ccloud cluster sql <CLUSTER_NAME> --connection-string
#
# Vector indexes require CockroachDB v25.2 or newer.
DATABASE_URL="postgresql://<user>:<password>@<host>:26257/aegis?sslmode=verify-full"

# Local single-node alternative (see docker-compose.yml):
# DATABASE_URL="postgresql://root@localhost:26257/aegis?sslmode=disable"

# Optional: path to a CA cert if your cluster's root CA is not in the system store.
# DATABASE_CA_CERT_PATH="./certs/root.crt"

# Max connections held by the app's pool.
DATABASE_POOL_MAX="10"

# ── Amazon Bedrock ───────────────────────────────────────────────────────────
AWS_REGION="us-east-1"
# Credentials resolve through the standard AWS chain (env vars, shared profile,
# SSO, IMDS, ECS task role, Lambda execution role). Set these only for local dev.
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_SESSION_TOKEN=""
# AWS_PROFILE="default"

# Embeddings — Amazon Titan Text Embeddings V2.
# Titan V2 supports 1024 (default), 512, or 256 dimensions.
BEDROCK_EMBEDDING_MODEL_ID="amazon.titan-embed-text-v2:0"
EMBEDDING_DIM="1024"

# Gatekeeper LLM. Must match a model enabled in your Bedrock account/region.
# Cross-region inference profiles (the `us.` / `eu.` prefix) are recommended.
#   us.anthropic.claude-sonnet-5            <- default, current generation
#   us.anthropic.claude-opus-5              <- highest capability
#   us.anthropic.claude-haiku-4-5           <- cheapest / fastest
#   anthropic.claude-3-5-sonnet-20241022-v2:0  <- legacy on-demand ID
BEDROCK_LLM_MODEL_ID="us.anthropic.claude-sonnet-5"

# auto | live | mock
#   auto  — use Bedrock if credentials resolve, otherwise fall back to the
#           deterministic local gatekeeper (best for demos).
#   live  — require Bedrock; fail loudly if it is unreachable.
#   mock  — never call Bedrock (offline development).
AEGIS_BEDROCK_MODE="auto"

# ── Amazon S3 (raw document provenance) ──────────────────────────────────────
S3_BUCKET="aegis-memory-provenance"
S3_PREFIX="raw/"
# auto | live | mock  — same semantics as AEGIS_BEDROCK_MODE.
AEGIS_S3_MODE="auto"

# ── Write-Gate tuning ────────────────────────────────────────────────────────
# A distance threshold is only meaningful in the embedding space it was measured
# in, so there are two of each: one for Titan's semantic space, one for the local
# fallback's lexical space. `gateThresholds()` picks the pair matching whichever
# embedder actually produced the vector.
#
# IMPORTANT: with no AWS credentials, Aegis runs on the local embedder, so the
# *_LOCAL values are the ones governing your demo. Tuning GATE_SIMILARITY_
# THRESHOLD alone will appear to do nothing. A single shared constant was tried
# first and made the demo show no conflicts at all.

# Cosine distance (0 = identical, 2 = opposite). Neighbours closer than this are
# sent to the gatekeeper for adjudication. Titan's space is tighter, so its
# threshold is lower.
GATE_SIMILARITY_THRESHOLD="0.35"
# Same cutoff for the local lexical embedder, which spreads related text further
# apart. Set too low, nothing is ever adjudicated and every fact is ALLOWED.
GATE_SIMILARITY_THRESHOLD_LOCAL="0.72"

# Below this distance a candidate is treated as a restatement and MERGED rather
# than stored again. Tighten it if genuine updates are being absorbed as
# duplicates; loosen it if the substrate fills with paraphrases.
GATE_MERGE_THRESHOLD="0.06"
GATE_MERGE_THRESHOLD_LOCAL="0.14"

# How many nearest neighbours to retrieve per submission.
GATE_TOP_K="5"
# Below this confidence a fact is quarantined without consulting the LLM.
GATE_MIN_CONFIDENCE="0.35"

# ── CockroachDB Cloud MCP Server (read-only audit plane) ─────────────────────
# Used by /api/mcp/inspect and by mcp/cockroach-mcp.config.json.
CRDB_MCP_URL="https://cockroachlabs.cloud/mcp"
# Service-account API key (Cloud Console → Access Management → Service Accounts).
# Leave blank to use OAuth from your MCP client instead.
CRDB_MCP_API_KEY=""
# Scope the MCP server to a single cluster (optional but recommended).
CRDB_MCP_CLUSTER_ID=""
